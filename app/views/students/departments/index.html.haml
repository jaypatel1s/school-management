.main-content-container.overflow-hidden
  .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-4
    %h3.mb-0 Departments
    %div
      %span.badge.bg-info #{@departments.count} Departments

.row
  .col-md-12
    .card.mb-4
      .card-body
        .table-responsive
          %table.table
            %thead
              %tr
                %th Department Name
                %th Courses
                %th Teachers
                %th Actions
            %tbody
              - @departments.each do |department|
                %tr
                  %td= department.name
                  %td= department.courses.count
                  %td= department.teachers.count
                  %td
                    = link_to 'View Details', college_students_department_path(current_college.slug, department.slug), class: 'btn btn-sm btn-primary'
