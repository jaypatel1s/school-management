.main-content-container.overflow-hidden
  .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-4
    %div
      %h3.mb-0 Receipt Details
      %small.text-muted Receipt ##{@receipt.receipt_number}
    %div
      = link_to 'Back to Receipts', college_students_receipts_path(current_college.slug), class: 'btn btn-secondary'
      = link_to 'Download', download_college_students_receipt_path(current_college.slug, @receipt.id), class: 'btn btn-primary ml-2'

.row
  .col-md-12
    .card.mb-4
      .card-body
        .row
          .col-md-6
            %table.table.table-borderless
              %tr
                %td
                  %strong Receipt Number:
                %td= @receipt.receipt_number
              %tr
                %td
                  %strong Date:
                %td= @receipt.created_at.strftime('%B %d, %Y at %I:%M %p')
              %tr
                %td
                  %strong Fee Structure:
                %td= @receipt.student_fee&.fee_structure&.name
              %tr
                %td
                  %strong Semester:
                %td= @receipt.student_fee&.semester&.name
          .col-md-6
            %table.table.table-borderless
              %tr
                %td
                  %strong Amount Paid:
                %td= number_to_currency(@receipt.admission_payment&.amount)
              %tr
                %td
                  %strong Payment Method:
                %td= @receipt.admission_payment&.payment_mode&.titleize
              %tr
                %td
                  %strong Transaction ID:
                %td= @receipt.admission_payment&.transaction_id
              %tr
                %td
                  %strong Status:
                %td
                  %span.badge{class: "badge-#{@receipt.admission_payment&.payment_status == 'paid' ? 'success' : 'warning'}"}
                    = @receipt.admission_payment&.payment_status&.titleize

.row
  .col-md-12
    .card.mb-4
      .card-body
        %h5 Student Information
        .row
          .col-md-6
            %table.table.table-borderless
              %tr
                %td
                  %strong Name:
                %td= @profile.user.name
              %tr
                %td
                  %strong Roll Number:
                %td= @profile.roll_number
              %tr
                %td
                  %strong Email:
                %td= @profile.user.email
          .col-md-6
            %table.table.table-borderless
              %tr
                %td
                  %strong College:
                %td= @profile.college.name
              %tr
                %td
                  %strong Department:
                %td= @profile.department&.name
              %tr
                %td
                  %strong Course:
                %td= @profile.courses.first&.name
