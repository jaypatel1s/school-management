.main-content-container.overflow-hidden
  .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-4
    %h3.mb-0 Attendance Report
    %div
      = link_to 'Back to Session', college_students_session_path(current_college.slug, @session.slug), class: 'btn btn-secondary'

.row
  .col-md-12
    .card.mb-4
      .card-body
        %h5 Your comprehensive attendance statistics

        .row
          .col-md-3
            .card.bg-primary.text-white
              .card-body
                %h3= @attendance_stats[:total]
                %p Total Sessions
          .col-md-3
            .card.bg-success.text-white
              .card-body
                %h3= @attendance_stats[:present]
                %p Present
          .col-md-3
            .card.bg-danger.text-white
              .card-body
                %h3= @attendance_stats[:absent]
                %p Absent
          .col-md-3
            .card.bg-warning.text-white
              .card-body
                %h3= @attendance_stats[:late]
                %p Late

        .row.mt-4
          .col-md-12
            %h5 Attendance Percentage
            - percentage = @attendance_stats[:total] > 0 ? (@attendance_stats[:present].to_f / @attendance_stats[:total] * 100).round(2) : 0
            .progress
              .progress-bar{role: 'progressbar', style: "width: #{percentage}%", 'aria-valuenow': percentage, 'aria-valuemin': 0, 'aria-valuemax': 100}
                = "#{percentage}%"

        .row.mt-4
          .col-md-12
            %h5 Detailed Records
            .table-responsive
              %table.table
                %thead
                  %tr
                    %th Date
                    %th Session
                    %th Course
                    %th Status
                %tbody
                  - @attendances.each do |attendance|
                    %tr
                      %td= attendance.session&.date&.strftime('%b %d, %Y')
                      %td= attendance.session&.name
                      %td= attendance.session&.course&.name
                      %td
                        %span.badge{class: "badge-#{attendance.status == 'present' ? 'success' : 'danger'}"}
                          = attendance.status.titleize

        .row.mt-4
          .col-md-12
            = link_to 'Download Report', '#', class: 'btn btn-primary'
