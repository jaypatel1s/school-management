.main-content-container.overflow-hidden
  .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-4
    %h3.mb-0 Welcome, #{@profile.user.name}!
    %div
      %span.badge.bg-primary #{@profile.college.name}

.row
  .col-md-6
    .card.mb-4
      .card-body
        %h5.card-title Recent Attendance
        .table-responsive
          %table.table
            %thead
              %tr
                %th Date
                %th Course
                %th Status
            %tbody
              - @recent_attendances.each do |attendance|
                %tr
                  %td= attendance.session&.date&.strftime('%b %d, %Y')
                  %td= attendance.session&.course&.name
                  %td
                    %span.badge{class: "badge-#{attendance.status == 'present' ? 'success' : 'danger'}"}
                      = attendance.status.titleize

  .col-md-6
    .card.mb-4
      .card-body
        %h5.card-title Recent Assignments
        .table-responsive
          %table.table
            %thead
              %tr
                %th Assignment
                %th Course
                %th Due Date
            %tbody
              - @recent_assignments.each do |assignment|
                %tr
                  %td= assignment.name
                  %td= assignment.course&.name
                  %td= assignment.created_at.strftime('%b %d, %Y')

.row
  .col-md-12
    .card.mb-4
      .card-body
        %h5.card-title Upcoming Exams
        .table-responsive
          %table.table
            %thead
              %tr
                %th Exam
                %th Course
                %th Date
                %th Type
            %tbody
              - @upcoming_exams.each do |exam|
                %tr
                  %td= exam.name
                  %td= exam.course&.name
                  %td= exam.scheduled_at.strftime('%b %d, %Y %H:%M')
                  %td= exam.exam_type.titleize
