.main-content-container.overflow-hidden
  .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-4
    %h3.mb-0 My Courses
    %div
      %span.badge.bg-info #{@courses.count} Courses
      
.row
  .col-md-12
    .card.mb-4
      .card-body
        .table-responsive
          %table.table
            %thead
              %tr
                %th Course Name
                %th Department
                %th Teacher
                %th Credits
                %th Actions
            %tbody
              - @courses.each do |course|
                %tr
                  %td= course.name
                  %td= course.department&.name
                  %td= course.teachers.map(&:user).map(&:name).join(', ')
                  %td= course.credits
                  %td
                    = link_to 'View Details', college_students_course_path(current_college.slug, course.slug), class: 'btn btn-sm btn-primary'
                    = link_to 'Sessions', college_students_sessions_path(current_college.slug, course_id: course.id), class: 'btn btn-sm btn-info ml-1'
